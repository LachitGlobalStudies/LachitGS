<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    tools:context=".Fragments.DescriptionFragment">


        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" >
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:id="@+id/batche_name"
                    android:textSize="30sp"
                    android:textAlignment="center"
                    android:text="batch_name"/>

<LinearLayout
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:gravity="center"
    android:layout_height="30dp">
    <ImageView
        android:layout_width="30dp"
        android:layout_height="match_parent"
        android:src="@drawable/calendar"/>
    <TextView
        android:layout_marginStart="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Starts on "/>
    <TextView
        android:id="@+id/starts_on"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="jkjdfkljk "/>
    <LinearLayout
        android:layout_marginStart="5dp"
        android:layout_width="2dp"
        android:layout_height="15dp"
        android:background="@color/black"/>

    <TextView
        android:layout_marginStart="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ends on "/>
    <TextView
        android:id="@+id/ends_on"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="hjfdshjhjksd "/>

</LinearLayout>
            <androidx.cardview.widget.CardView
                android:layout_marginTop="15dp"
                android:layout_width="300dp"
                android:layout_gravity="center"
                android:layout_height="150dp"
                app:cardCornerRadius="15dp">
                <com.makeramen.roundedimageview.RoundedImageView
                    xmlns:app="http://schemas.android.com/apk/res-auto"
                    android:id="@+id/thumbnail"
                    android:scaleType="fitXY"
                    app:riv_corner_radius="1dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>

            </androidx.cardview.widget.CardView>


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:text="The list of  teacher who teach the batch"
                    android:textAlignment="center"
                    android:textSize="20sp"/>
                <androidx.cardview.widget.CardView
                    android:layout_width="300dp"
                    android:layout_gravity="center"
                    android:layout_height="150dp"
                    app:cardCornerRadius="15dp">
                    <com.makeramen.roundedimageview.RoundedImageView
                        xmlns:app="http://schemas.android.com/apk/res-auto"
                        android:id="@+id/teacher_list"
                        android:scaleType="fitXY"
                        app:riv_corner_radius="1dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </androidx.cardview.widget.CardView>


                <TextView
                    android:id="@+id/topic_cover"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:text=""
                    android:textAlignment="center"
                    android:textSize="20sp"/>

            </LinearLayout>
        </ScrollView>

</LinearLayout>

