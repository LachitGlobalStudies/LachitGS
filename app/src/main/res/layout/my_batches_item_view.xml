<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_marginTop="15dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">


    <androidx.cardview.widget.CardView
        android:layout_margin="15dp"
        android:layout_width="match_parent"
        app:cardCornerRadius="12dp"
        android:layout_height="450dp" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="40dp">

                <TextView
                    android:id="@+id/course_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:text="Polity Foundation"
                    android:textColor="@color/black"
                    android:textSize="20dp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/imageView14"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/new_batch" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/batch_thumbnail_card"
                android:layout_margin="15dp"
                android:layout_width="match_parent"
                android:layout_marginTop="30dp"
                app:cardCornerRadius="15dp"
                android:layout_height="150dp">

                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/thumbnail"
                    android:scaleType="fitXY"
                    app:riv_corner_radius="1dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>

            </androidx.cardview.widget.CardView>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/calender"
                    android:layout_width="20dp"
                    android:layout_height="25dp"
                    android:layout_marginStart="20dp"
                    app:srcCompat="@drawable/calendar" />

                <TextView
                    android:id="@+id/start_on"
                    android:layout_marginStart="5dp"
                    android:layout_toEndOf="@+id/calender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stars on" />
                <TextView
                    android:id="@+id/start_date"
                    android:layout_marginStart="5dp"
                    android:layout_toEndOf="@+id/start_on"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:text="13 jul 2023" />
                <TextView
                    android:id="@+id/end_on"
                    android:layout_marginStart="5dp"
                    android:layout_toEndOf="@+id/start_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="* Ends on" />
                <TextView
                    android:id="@+id/end_date"
                    android:layout_marginStart="5dp"
                    android:layout_toEndOf="@+id/end_on"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:text="13 jul 2023" />

                <ImageView
                    android:id="@+id/course_duration"
                    android:layout_width="20dp"
                    android:layout_height="25dp"
                    android:layout_below="@id/calender"
                    android:layout_marginStart="20dp"
                    app:srcCompat="@drawable/star" />
                <TextView
                    android:layout_marginTop="10dp"
                    android:layout_below="@id/start_on"
                    android:layout_marginStart="5dp"
                    android:layout_toEndOf="@+id/course_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:text="@string/course_duration" />

            </RelativeLayout>
            <LinearLayout
                android:layout_marginTop="5dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/black">
            </LinearLayout>

            <TextView
                android:id="@+id/price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:textStyle="bold"
                android:textSize="25sp"
                android:textColor="@color/blue"
                android:text="RS. 700" />

            <TextView
                android:layout_marginStart="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(FOR ALL COURSE)" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="7dp"
                android:orientation="horizontal">

                <Button
                    android:layout_marginTop="15dp"
                    android:id="@+id/lets_study"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/menu_background"
                    android:text="Let's Study" />


            </LinearLayout>


        </LinearLayout>



    </androidx.cardview.widget.CardView>
</LinearLayout>