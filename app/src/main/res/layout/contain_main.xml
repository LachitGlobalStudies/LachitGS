<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/container">
      <androidx.constraintlayout.widget.ConstraintLayout
          android:layout_marginTop="15dp"
          android:layout_width="match_parent"
          android:layout_height="match_parent">

          <ScrollView
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              app:layout_constraintBottom_toBottomOf="parent"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toTopOf="parent">

              <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="match_parent"
                  android:gravity="center"
                  android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="340dp"
                    app:cardCornerRadius="20dp"
                    android:layout_height="200dp">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <androidx.viewpager.widget.ViewPager
                            android:id="@+id/viewPager"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                        <LinearLayout
                            android:id="@+id/dotsLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:layout_marginBottom="16dp"
                            android:gravity="center"
                            android:orientation="horizontal" />


                    </RelativeLayout>

                </androidx.cardview.widget.CardView>


                  <TextView
                      android:id="@+id/textView5"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_marginStart="8dp"
                      android:layout_marginTop="25dp"
                      android:text="Explore to learn effectively!"
                      android:textColor="@color/black"
                      android:textSize="23sp"
                      android:textStyle="bold" />

                  <GridLayout
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:alignmentMode="alignMargins"
                      android:columnOrderPreserved="false"
                      android:orientation="vertical">


                      <androidx.cardview.widget.CardView
                          android:id="@+id/card_view_live_batces"
                          android:layout_width="match_parent"
                          android:layout_height="60dp"
                          android:layout_margin="8dp"
                          android:layout_marginTop="15dp"
                          app:cardCornerRadius="12dp">

                          <LinearLayout
                              android:layout_width="match_parent"
                              android:layout_height="wrap_content"
                              android:orientation="vertical">

                              <LinearLayout
                                  android:id="@+id/live_batcs"
                                  android:layout_width="match_parent"
                                  android:layout_height="wrap_content"
                                  android:gravity="center"
                                  android:orientation="horizontal">

                                  <ImageView
                                      android:id="@+id/imageView8"
                                      android:layout_width="40dp"
                                      android:layout_height="37dp"
                                      android:layout_marginStart="120dp"
                                      android:layout_marginTop="5dp"
                                      android:layout_marginBottom="3dp"
                                      app:srcCompat="@drawable/ic_live_batches_bishnuyash" />

                                  <TextView
                                      android:layout_width="wrap_content"
                                      android:layout_height="wrap_content"
                                      android:layout_marginStart="10dp"
                                      android:layout_weight="1"
                                      android:text="Live Batches"
                                      android:textColor="@color/black"
                                      android:textStyle="bold" />

                              </LinearLayout>

                              <LinearLayout
                                  android:layout_width="match_parent"
                                  android:layout_height="4dp"
                                  android:layout_marginTop="10dp"
                                  android:layout_marginBottom="0dp"
                                  android:background="@drawable/blue_circle"
                                  android:orientation="horizontal">

                              </LinearLayout>

                          </LinearLayout>
                      </androidx.cardview.widget.CardView>


                      <androidx.constraintlayout.widget.ConstraintLayout
                          android:layout_width="match_parent"
                          android:layout_height="70dp"
                          android:layout_marginTop="12dp">

                          <androidx.cardview.widget.CardView
                              android:id="@+id/card_view_recorded_batces"
                              android:layout_width="170dp"
                              android:layout_height="65dp"
                              android:layout_marginStart="8dp"
                              android:layout_marginEnd="4dp"
                              app:cardCornerRadius="8dp"
                              app:layout_constraintBottom_toBottomOf="parent"
                              app:layout_constraintEnd_toStartOf="@+id/card_view_test_series"
                              app:layout_constraintStart_toStartOf="parent"
                              app:layout_constraintTop_toTopOf="parent">

                              <LinearLayout
                                  android:layout_width="match_parent"
                                  android:layout_height="match_parent"
                                  android:orientation="horizontal">

                                  <ImageView
                                      android:id="@+id/recorded_video_icon"
                                      android:layout_width="30dp"
                                      android:layout_height="27dp"
                                      android:layout_marginStart="8dp"
                                      android:layout_marginTop="20dp"
                                      android:layout_marginEnd="3dp"
                                      app:srcCompat="@drawable/ic_recorded_batches" />

                                  <TextView
                                      android:layout_width="wrap_content"
                                      android:layout_height="wrap_content"
                                      android:layout_marginStart="3dp"
                                      android:layout_marginTop="20dp"
                                      android:layout_marginEnd="5dp"
                                      android:layout_weight="1"
                                      android:text="Recorded Batches"
                                      android:textColor="@color/black"
                                      android:textStyle="bold" />
                              </LinearLayout>

                          </androidx.cardview.widget.CardView>

                          <androidx.cardview.widget.CardView
                              android:id="@+id/card_view_test_series"
                              android:layout_width="170dp"
                              android:layout_height="65dp"
                              android:layout_marginStart="4dp"
                              android:layout_marginEnd="8dp"
                              app:cardCornerRadius="8dp"
                              app:layout_constraintBottom_toBottomOf="parent"
                              app:layout_constraintEnd_toEndOf="parent"
                              app:layout_constraintStart_toEndOf="@id/card_view_recorded_batces"
                              app:layout_constraintTop_toTopOf="parent">

                              <LinearLayout
                                  android:layout_width="match_parent"
                                  android:layout_height="match_parent"
                                  android:orientation="horizontal">

                                  <ImageView
                                      android:layout_width="30dp"
                                      android:layout_height="27dp"
                                      android:layout_marginStart="8dp"
                                      android:layout_marginTop="15dp"
                                      android:layout_marginEnd="3dp"
                                      app:srcCompat="@drawable/test_series_icon" />

                                  <TextView
                                      android:layout_width="wrap_content"
                                      android:layout_height="wrap_content"
                                      android:layout_marginStart="3dp"
                                      android:layout_marginTop="15dp"
                                      android:layout_weight="1"
                                      android:text="Test Series"
                                      android:textColor="@color/black"
                                      android:textStyle="bold" />
                              </LinearLayout>

                          </androidx.cardview.widget.CardView>
                      </androidx.constraintlayout.widget.ConstraintLayout>


                      <androidx.constraintlayout.widget.ConstraintLayout
                          android:layout_width="match_parent"
                          android:layout_height="70dp"
                          android:layout_marginTop="12dp"
                          android:padding="0dp">

                          <androidx.cardview.widget.CardView
                              android:id="@+id/card_view_free_study_material"
                              android:layout_width="170dp"
                              android:layout_height="65dp"
                              android:layout_marginStart="8dp"
                              android:layout_marginEnd="4dp"
                              app:cardCornerRadius="8dp"
                              app:layout_constraintBottom_toBottomOf="parent"
                              app:layout_constraintEnd_toStartOf="@+id/card_view_current_affairs"
                              app:layout_constraintStart_toStartOf="parent"
                              app:layout_constraintTop_toTopOf="parent">

                              <LinearLayout
                                  android:layout_width="match_parent"
                                  android:layout_height="match_parent"
                                  android:orientation="horizontal">

                                  <ImageView

                                      android:layout_width="30dp"
                                      android:layout_height="wrap_content"
                                      android:layout_marginStart="8dp"
                                      android:layout_marginTop="15dp"
                                      android:layout_marginEnd="3dp"
                                      app:srcCompat="@drawable/ic_free_study" />

                                  <TextView
                                      android:layout_width="wrap_content"
                                      android:layout_height="wrap_content"
                                      android:layout_marginStart="3dp"
                                      android:layout_marginTop="15dp"
                                      android:layout_weight="1"
                                      android:text="Free Study\n Materials"
                                      android:textColor="@color/black"
                                      android:textStyle="bold" />
                              </LinearLayout>

                          </androidx.cardview.widget.CardView>

                          <androidx.cardview.widget.CardView
                              android:id="@+id/card_view_current_affairs"
                              android:layout_width="170dp"
                              android:layout_height="65dp"
                              android:layout_marginStart="4dp"
                              android:layout_marginEnd="8dp"
                              app:cardCornerRadius="8dp"
                              app:layout_constraintBottom_toBottomOf="parent"
                              app:layout_constraintEnd_toEndOf="parent"
                              app:layout_constraintStart_toEndOf="@id/card_view_free_study_material"
                              app:layout_constraintTop_toTopOf="parent">
                              <LinearLayout
                                  android:layout_width="match_parent"
                                  android:layout_height="match_parent"
                                  android:orientation="horizontal">

                                  <ImageView
                                      android:layout_width="30dp"
                                      android:layout_height="27dp"
                                      android:layout_marginStart="8dp"
                                      android:layout_marginTop="15dp"
                                      android:layout_marginEnd="3dp"
                                      app:srcCompat="@drawable/ic_current_affairs" />

                                  <TextView
                                      android:layout_width="wrap_content"
                                      android:layout_height="wrap_content"
                                      android:layout_marginStart="3dp"
                                      android:layout_marginTop="15dp"
                                      android:layout_weight="1"
                                      android:text="Current Affairs"
                                      android:textColor="@color/black"
                                      android:textStyle="bold" />
                              </LinearLayout>

                          </androidx.cardview.widget.CardView>
                      </androidx.constraintlayout.widget.ConstraintLayout>


                      <androidx.cardview.widget.CardView
                          android:id="@+id/card_view_download"
                          android:layout_width="match_parent"
                          android:layout_height="60dp"
                          android:layout_margin="8dp"
                          android:layout_marginTop="15dp"
                          android:background="@drawable/back_grey"
                          app:cardCornerRadius="12dp">

                          <androidx.constraintlayout.widget.ConstraintLayout
                              android:layout_width="match_parent"
                              android:layout_height="60dp"
                              android:layout_marginTop="2dp"
                              android:backgroundTint="@color/grey">

                              <ImageView
                                  android:id="@+id/imageView11"
                                  android:layout_width="wrap_content"
                                  android:layout_height="wrap_content"
                                  android:layout_margin="10dp"
                                  app:layout_constraintBottom_toBottomOf="parent"
                                  app:layout_constraintStart_toStartOf="parent"
                                  app:layout_constraintTop_toTopOf="parent"
                                  app:srcCompat="@drawable/ic_my_downloads_bishnuyash" />

                              <TextView
                                  android:id="@+id/textView2"
                                  android:layout_width="wrap_content"
                                  android:layout_height="wrap_content"
                                  android:layout_marginStart="20dp"
                                  android:layout_marginTop="6dp"
                                  android:text="My Downloads"
                                  android:textColor="@color/black"
                                  android:textStyle="bold"
                                  app:layout_constraintBottom_toBottomOf="parent"
                                  app:layout_constraintStart_toEndOf="@+id/imageView11"
                                  app:layout_constraintTop_toTopOf="parent" />

                              <ImageView
                                  android:layout_width="40dp"
                                  android:layout_height="40dp"
                                  android:background="@drawable/blue_circle"
                                  app:layout_constraintBottom_toBottomOf="parent"
                                  app:layout_constraintEnd_toEndOf="parent"
                                  app:layout_constraintTop_toTopOf="parent"
                                  android:layout_marginEnd="15dp"
                                  app:srcCompat="@drawable/ic_arrow_right" />
                          </androidx.constraintlayout.widget.ConstraintLayout>
                      </androidx.cardview.widget.CardView>
                  </GridLayout>

                  <TextView
                      android:layout_width="match_parent"
                      android:layout_height="match_parent"
                      android:text="Recomended Videos"
                      android:textSize="25sp"
                      android:layout_marginStart="10dp"
                      android:textColor="@color/black"/>

                      <LinearLayout
                          android:layout_marginTop="15dp"
                          android:layout_width="match_parent"
                          android:gravity="center"
                          android:layout_height="250dp">

                          <androidx.recyclerview.widget.RecyclerView
                              android:id="@+id/recycler_recomended"
                              android:layout_width="match_parent"
                              android:layout_height="match_parent"
                              tools:listitem="@layout/recomended_video_item_view" />
                      </LinearLayout>


                  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Share our app"
    android:textSize="22sp"
    android:layout_marginTop="15dp"
    android:layout_marginStart="15dp"
    android:textStyle="bold"/>
                  <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:background="@drawable/share_bakcgroun"
                    android:layout_height="130dp">

                      <androidx.cardview.widget.CardView
                          android:id="@+id/share_card_view"
                          android:layout_width="145dp"
                          android:layout_height="40dp"
                          android:layout_marginTop="94dp"
                          android:layout_marginEnd="56dp"
                          android:background="@color/blue"
                          app:cardCornerRadius="9dp"
                          app:layout_constraintBottom_toBottomOf="parent"
                          app:layout_constraintEnd_toEndOf="parent"
                          app:layout_constraintTop_toTopOf="parent">
                          <RelativeLayout
                              android:layout_width="match_parent"
                              android:background="@color/blue"
                              android:layout_gravity="center"
                              android:gravity="center"
                              android:layout_height="match_parent">
                              <TextView
                                  android:layout_marginTop="8dp"
                                  android:layout_marginStart="10dp"
                                 android:id="@+id/xyz"
                                  android:layout_width="wrap_content"
                                  android:layout_height="wrap_content"
                                  android:text="Share App"
                                  android:textColor="#FFFFFF"
                                  android:textStyle="bold"/>
                              <TextView
                                  android:foregroundGravity="center"
                                  android:layout_marginTop="4dp"
                                  android:layout_marginStart="30dp"
                                  android:layout_toRightOf="@+id/xyz"
                                  android:layout_width="25dp"
                                  android:layout_height="25dp"
                                  android:gravity="center"
                                  android:text=">"
                                  android:textSize="20sp"
                                  android:textColor="@color/blue"
                                  android:background="@drawable/white_circle"/>

                          </RelativeLayout>

                      </androidx.cardview.widget.CardView>


                  </androidx.constraintlayout.widget.ConstraintLayout>

                  <androidx.constraintlayout.widget.ConstraintLayout
                      android:layout_marginTop="20dp"
                     android:layout_width="match_parent"
                      android:layout_height="150dp"
                      android:background="@drawable/share_bakcgroun_contact"
                       >
                      <androidx.cardview.widget.CardView
                          android:id="@+id/whats_app_card"
                          android:layout_width="142dp"
                          android:layout_height="40dp"
                          android:layout_marginTop="125dp"
                          android:layout_marginEnd="20dp"
                          android:background="@color/blue"
                          app:cardCornerRadius="9dp"
                          app:layout_constraintBottom_toBottomOf="parent"
                          app:layout_constraintEnd_toEndOf="parent"
                          app:layout_constraintTop_toTopOf="parent">
                          <RelativeLayout
                              android:layout_width="match_parent"
                              android:background="@color/blue"
                              android:layout_height="match_parent">
                              <de.hdodenhof.circleimageview.CircleImageView
                                  android:layout_marginTop="2dp"
                                  android:layout_marginBottom="2dp"
                                  android:layout_marginStart="2dp"
                                  android:id="@+id/xy"
                                  android:src="@drawable/whats_app"
                                  android:layout_width="30dp"
                                  android:layout_height="30dp"
                                  android:text="Share App"
                                  android:textColor="#FFFFFF"
                                  android:textStyle="bold"/>
                              <TextView
                                  android:layout_marginTop="5dp"
                                  android:layout_toRightOf="@+id/xy"
                                  android:layout_width="wrap_content"
                                  android:layout_marginStart="2dp"
                                  android:layout_height="25dp"
                                  android:gravity="center"
                                  android:text="Whatsapp"
                                  android:textSize="20sp"
                                  android:textColor="@color/white"/>

                          </RelativeLayout>

                      </androidx.cardview.widget.CardView>

                      <androidx.cardview.widget.CardView
                          android:padding="2dp"
                          android:id="@+id/call_card"
                          android:layout_width="85dp"
                          android:layout_height="40dp"
                          android:layout_marginStart="110dp"
                          android:layout_marginTop="125dp"
                          android:background="#6F7BEA"
                          app:cardCornerRadius="9dp"
                          app:layout_constraintBottom_toBottomOf="parent"
                          app:layout_constraintStart_toStartOf="parent"
                          app:layout_constraintTop_toTopOf="parent">

                          <RelativeLayout
                              android:layout_width="match_parent"
                              android:layout_height="match_parent"
                              android:background="@color/blue">

                              <de.hdodenhof.circleimageview.CircleImageView
                                  android:id="@+id/x"
                                  android:layout_width="30dp"
                                  android:layout_height="30dp"
                                  android:layout_marginTop="2dp"
                                  android:layout_marginBottom="2dp"
                                  android:src="@drawable/baseline_call_24"
                                  android:text="Share App"
                                  android:textColor="#FFFFFF"
                                  android:textStyle="bold" />

                              <TextView
                                  android:layout_width="wrap_content"
                                  android:layout_height="25dp"
                                  android:layout_marginStart="5dp"
                                  android:layout_marginTop="5dp"
                                  android:layout_toRightOf="@+id/x"
                                  android:gravity="center"
                                  android:text="Call"
                                  android:textColor="@color/white"
                                  android:textSize="20sp" />

                          </RelativeLayout>

                      </androidx.cardview.widget.CardView>

                  </androidx.constraintlayout.widget.ConstraintLayout>
                  <LinearLayout
                      android:layout_width="match_parent"
                      android:layout_height="50dp">

                  </LinearLayout>
                 <!-- <Switch
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:text="Transfer the Batch"
                      android:id="@+id/switch_to_other_batches"/>
-->

              </LinearLayout>
          </ScrollView>
      </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>

</LinearLayout>